{
  "name": "nott2-online",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "lint": "turbo run lint",
    "docs:dev": "turbo run docs:dev --filter=@nott2/design-system-docs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.5.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
