# ============================================================
# Night of the Thirteenth 2 — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Firebase (required for multiplayer) ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── WebRTC TURN Server (required for cross-network multiplayer)
# Sign up at https://www.metered.ca (free tier: 50GB/month)
# Retrieve credentials from your Metered.ca dashboard.
NEXT_PUBLIC_TURN_URL=turn:openrelay.metered.ca:443?transport=tcp
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# ── Phase 9: Discord SSO (NextAuth.js) ──────────────────────
# Leave blank until Phase 9 is implemented.
# Generate AUTH_SECRET with:  npx auth secret
AUTH_SECRET=
# From: Discord Developer Portal > Your App > OAuth2 > Client ID
AUTH_DISCORD_ID=
# From: Discord Developer Portal > Your App > OAuth2 > Client Secret
AUTH_DISCORD_SECRET=
# Right-click your Discord server > Copy Server ID (Developer Mode required)
DISCORD_GUILD_ID=
# Right-click the Patreon subscriber role > Copy Role ID
DISCORD_PREMIUM_ROLE_ID=
# From: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON as a single-line string (or use a multiline secret in Vercel)
FIREBASE_SERVICE_ACCOUNT_JSON=
